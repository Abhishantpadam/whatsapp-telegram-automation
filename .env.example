# ========================================================
# WhatsApp → Telegram Channel Automation
# Environment Configuration Template
# ========================================================

# 1. Telegram Bot Token (Obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Telegram Destination Channel ID or @channel_username
# Tip: Channel IDs usually begin with -100 (e.g., -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# 3. Telegram Admin User ID (Required for cleaner.js admin menu)
# Tip: Message @userinfobot on Telegram to get your numeric user ID
TELEGRAM_ADMIN_ID=123456789
